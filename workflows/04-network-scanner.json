          "combinator": "and"
        },
        "options": {}
      },
      "name": "New devices?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1220,
        120
      ],
      "id": "9a52b6ef-0952-4bb1-b514-88e9a48ef623"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "={{ String(($json.firstRun\n    ? '📋 SecureNet | Línea base de red creada (' + $json.known + ' dispositivos)'\n    : '🚨 SecureNet | ' + $json.newDevices.length + ' dispositivo(s) NUEVO(S) en la red')\n  + '\\n\\n' + $json.newDevices.map(d => '• ' + d.ip + ' | ' + d.mac + ' | ' + d.vendor).join('\\n')\n  + '\\n\\n🕒 Escaneo: ' + $json.scannedAt + '\\n📚 Conocidos: ' + $json.known).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
