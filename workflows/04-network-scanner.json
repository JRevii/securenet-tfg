    },
    {
      "parameters": {
        "operation": "text",
        "destinationKey": "baseline",
        "options": {}
      },
      "name": "Baseline to text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        800,
        200
      ],
      "id": "dd068db6-220d-4b0e-b3d1-9d78aec6b36d"
    },
    {
      "parameters": {
        "jsCode": "// B2: alert only on devices that are not in the baseline (MAC -> first seen)\nconst scan = String($('Scan to text').first().json.scan ?? '');\n\n// Refuse to work on a stale scan (cron broken) instead of re-reporting old data\nconst header = scan.match(/^=== SecureNet scan (\\S+) ===/m);\nconst scannedAt = header ? new Date(header[1]) : null;\nif (!scannedAt || isNaN(scannedAt) || Date.now() - scannedAt.getTime() > 45 * 60 * 1000) {\n  throw new Error(`scan.txt is stale or has no timestamp (${header ? header[1] : 'none'}): check the cron job on PC2`);\n}\n\nconst devices = [];\nfor (const block of scan.split('Nmap scan report for ').slice(1)) {\n  const ip = (block.match(/\\((\\d+\\.\\d+\\.\\d+\\.\\d+)\\)/) || block.match(/^(\\d+\\.\\d+\\.\\d+\\.\\d+)/m) || [])[1];\n  if (!ip) continue;\n  const mm = block.match(/MAC Address:\\s*([0-9A-F:]{17})\\s*\\((.*?)\\)/i);\n  const mac = mm ? mm[1].toUpperCase() : null;          // nmap shows no MAC for the scanning host\n  devices.push({ key: mac ?? `IP:${ip}`, ip, mac: mac ?? 'own host', vendor: mm ? mm[2] : '—' });\n}\nif (devices.length === 0) throw new Error('scan.txt parsed 0 hosts');\n\nlet baseline = {};\ntry {\n  const b = JSON.parse($json.baseline || '{}');\n  if (b && !Array.isArray(b) && typeof b === 'object') baseline = b;\n} catch (e) { baseline = {}; }\nconst firstRun = Object.keys(baseline).length === 0;\n\nconst now = new Date().toISOString();\nconst newDevices = [];\nfor (const d of devices) {\n  if (!baseline[d.key]) {\n    baseline[d.key] = { ip: d.ip, mac: d.mac, vendor: d.vendor, firstSeen: now, lastSeen: now };\n    newDevices.push(d);\n  } else {\n    Object.assign(baseline[d.key], { ip: d.ip, lastSeen: now });\n  }\n}\n\nreturn [{ json: {\n  firstRun, scannedAt: scannedAt.toISOString(), seen: devices.length,\n  known: Object.keys(baseline).length, newDevices,\n  notify: firstRun || newDevices.length > 0,\n  baselineText: JSON.stringify(baseline, null, 2) + '\\n',\n} }];"
      },
      "name": "Compare with baseline",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        200
      ],
      "id": "0ae061db-6095-44aa-9174-921d676364ee"
    },
