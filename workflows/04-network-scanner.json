    {
      "parameters": {
        "operation": "text",
        "destinationKey": "Text",
        "options": {}
      },
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        112,
        -16
      ],
      "id": "b20bc960-fca1-4fe2-a0b9-f516a159c76f",
      "name": "Extract from File"
    },
    {
      "parameters": {
        "jsCode": "// En tu input, el texto viene en $json.Text (por el nodo Extract from File)\nconst text = $json.Text || $json.text || $json.data || \"\";\n\n// Separamos por cada host detectado\nconst blocks = text.split(\"Nmap scan report for \").slice(1);\n\nconst devices = [];\n\nfor (const block of blocks) {\n\n  // Caso 1: \"hostname (192.168.2.1)\"\n  // Caso 2: \"192.168.2.10\"\n  let ip = null;\n\n  const ipParen = block.match(/\\((\\d+\\.\\d+\\.\\d+\\.\\d+)\\)/);\n  const ipPlain = block.match(/^(\\d+\\.\\d+\\.\\d+\\.\\d+)/m);\n\n  if (ipParen) ip = ipParen[1];\n  else if (ipPlain) ip = ipPlain[1];\n\n  // MAC + vendor\n  const macMatch = block.match(/MAC Address:\\s*([A-F0-9:]+)\\s*\\((.*?)\\)/i);\n\n  if (ip) {\n    devices.push({\n      ip,\n      mac: macMatch ? macMatch[1].toUpperCase() : \"UNKNOWN\",\n      vendor: macMatch ? macMatch[2] : \"Unknown\"\n    });\n  }\n}\n\n// Si no hay nada, devolvemos un item informativo (para debug)\nif (devices.length === 0) {\n  return [{ json: { error: \"No devices parsed\", hint: \"Check input text field name\", sample: text.slice(0, 200) } }];\n}\n\n// Devolvemos 1 item por dispositivo\nreturn devices.map(d => ({ json: d }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -16
      ],
      "id": "a85aa058-1ee1-46b9-9fd2-9ba5c7c29426",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst lines = items.map(d => `• IP: ${d.ip} | MAC: ${d.mac} | Vendor: ${d.vendor}`);\n\nreturn [{\n  json: {\n    count: items.length,\n    summary: lines.join('\\n')\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        528,
        -16
      ],
      "id": "68ca66a7-61e6-48bf-b002-f32af5444509",
