{
  "name": "Pi-hole Stats  + Telegram",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "id": "f5c4b24e-5b89-4db6-ae48-240325546f3d",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "url": "http://192.168.2.10/api/stats/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FTL-SID",
              "value": "= {{$node[\"AUTH\"].json.session.sid}}"
            },
            {
              "name": " X-FTL-CSRF",
              "value": "={{$node[\"AUTH\"].json.session.csrf}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        416,
        0
      ],
      "id": "23ee0961-809f-4120-9074-b2b7e225b5fc",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.2.10/api/auth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{\n  \"Content-Type\": \"application/json\"\n}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"password\": \"<PIHOLE_WEB_PASSWORD>\"\n}",
        "options": {
          "response": {
            "response": {}
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        208,
        0
      ],
      "id": "315bef99-95a8-45fa-aa3e-8bb211848918",
      "name": "AUTH"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "=={{\"🛡️ SecureNet - Pi-hole\\n\\n\" +\"📡 Consultas DNS totales: \" + $json.queries.total + \"\\n\" +\"⛔ Bloqueadas: \" + $json.queries.blocked + \" (\" + $json.queries.percent_blocked + \"%)\\n\" +\"👥 Clientes activos: \" + $json.clients.active + \"\\n\" +\"📦 Dominios en Gravity: \" + $json.gravity.domains_being_blocked}}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        624,
        0
      ],
      "id": "6c0fc110-b0a6-4a2b-84fe-05a5d8f70731",
      "name": "Send a text message",
      "credentials": {
        "telegramApi": {
          "id": "<CREDENTIAL_ID>",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "AUTH",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AUTH": {
      "main": [
        [
          {
            "node": "HTTP Request1",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request1": {
      "main": [
        [
          {
            "node": "Send a text message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": false
  },
  "active": true
}
