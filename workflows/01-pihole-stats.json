{
  "name": "SecureNet - WF1 Pi-hole stats",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        200
      ],
      "id": "f5c4b24e-5b89-4db6-ae48-240325546f3d",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://192.168.2.10/api/auth",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {}
      },
      "name": "Login",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        220,
        200
      ],
      "id": "51cb2f2e-f35d-43e1-90f6-2b745e521c5b",
      "credentials": {
        "httpCustomAuth": {
          "id": "<CREDENTIAL_ID>",
          "name": "Pi-hole API (n8n app password)"
        }
      }
    },
    {
      "parameters": {
        "url": "http://192.168.2.10/api/stats/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FTL-SID",
              "value": "={{ $('Login').item.json.session.sid }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Get summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        440,
        200
      ],
      "id": "9020de20-400c-489b-ac76-a41f0550985b"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "={{ String([\n  '🛡️ SecureNet | Pi-hole',\n  '',\n  '📡 Consultas DNS totales: ' + $json.queries.total,\n  '⛔ Bloqueadas: ' + $json.queries.blocked + ' (' + Number($json.queries.percent_blocked).toFixed(1) + '%)',\n  '👥 Clientes activos: ' + $json.clients.active,\n  '📦 Dominios en Gravity: ' + $json.gravity.domains_being_blocked\n].join('\\n')).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        200
      ],
      "id": "94290305-d50d-49f5-a444-9a49d6fef970",
      "credentials": {
        "telegramApi": {
          "id": "<CREDENTIAL_ID>",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "http://192.168.2.10/api/auth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-FTL-SID",
              "value": "={{ $('Login').item.json.session.sid }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "name": "Logout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        880,
        200
      ],
      "id": "4db5344c-a90f-45d8-857f-8a7550d4ed36",
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Login",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Login": {
      "main": [
        [
          {
            "node": "Get summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get summary": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Telegram": {
      "main": [
        [
          {
            "node": "Logout",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": false,
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "<ERROR_WORKFLOW_ID>"
  },
  "tags": []
}
