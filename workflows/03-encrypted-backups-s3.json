{
  "name": "SecureNet - WF3 Encrypted backups to S3",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30 20 * * *"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        200
      ],
      "id": "d6de8693-c9c5-4ebb-b4c1-6bb2061d6b99",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "authentication": "privateKey",
        "command": "backup"
      },
      "name": "Run backup.sh",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        220,
        200
      ],
      "id": "ed76565d-3b52-49ef-81a0-19ba37805758",
      "credentials": {
        "sshPrivateKey": {
          "id": "<CREDENTIAL_ID>",
          "name": "SSH securenet-backup (key, forced command)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// B4: decide success from the script's real exit status, never assume OK\nconst r = $json;\nconst stdout = String(r.stdout ?? '');\nconst stderr = String(r.stderr ?? '');\nconst m = stdout.match(/EXIT_CODE:(\\d+)/);\nconst exitCode = m ? Number(m[1]) : (typeof r.code === 'number' ? r.code : -1);\nconst file = (stdout.match(/Backup OK:\\s*(\\S+)\\s+uploaded/) || [])[1] ?? null;\nconst ok = exitCode === 0 && file !== null;\nconst tail = (stdout + '\\n' + stderr).split('\\n')\n  .filter(l => l.trim() && !/Completed .* remaining/.test(l))\n  .slice(-8).join('\\n');\nreturn { json: { ok, exitCode, file, tail } };",
        "mode": "runOnceForEachItem"
      },
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        120
      ],
      "id": "9b039796-1148-4b3f-a2f6-9ea00f61f677"
    },
    {
      "parameters": {
        "jsCode": "// B4: the SSH step itself failed (host down, auth, timeout)\nconst e = $json.error;\nreturn { json: { ok: false, exitCode: -1, file: null,\n  tail: 'SSH error: ' + (typeof e === 'string' ? e : (e?.message ?? JSON.stringify(e))) } };",
        "mode": "runOnceForEachItem"
      },
      "name": "SSH failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "id": "6bdb921d-dc8b-43d9-ab50-33bbb80f7247"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "={{ String($json.ok\n  ? '✅ SecureNet | Backup diario OK\\n\\n📦 ' + $json.file + '\\n🕒 ' + $now.toFormat('yyyy-MM-dd HH:mm') + '\\n☁️ Cifrado (AES-256) y subido a S3'\n  : '❌ SecureNet | Backup FALLIDO\\n\\n🔢 Código de salida: ' + $json.exitCode + '\\n🕒 ' + $now.toFormat('yyyy-MM-dd HH:mm') + '\\n\\nÚltimas líneas:\\n' + $json.tail).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        200
      ],
      "id": "94bd6881-6e5e-4d19-8bd3-b97833929736",
      "credentials": {
        "telegramApi": {
          "id": "<CREDENTIAL_ID>",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Run backup.sh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run backup.sh": {
      "main": [
        [
          {
            "node": "Parse result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "SSH failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse result": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "SSH failed": {
      "main": [
        [
          {
            "node": "Send Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "availableInMCP": false,
    "timeSavedMode": "fixed",
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": "<ERROR_WORKFLOW_ID>"
  },
  "tags": []
}
