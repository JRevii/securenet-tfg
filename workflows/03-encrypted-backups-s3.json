        "sshPassword": {
          "id": "<CREDENTIAL_ID>",
          "name": "SSH Password account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = ($json.stdout || $json.data || '').toString();\n\nconst exitMatch = out.match(/EXIT_CODE:(\\d+)/);\nconst exitCode = exitMatch ? parseInt(exitMatch[1], 10) : 1;\n\n// intenta extraer el nombre del archivo .enc subido (del mensaje del script)\nconst fileMatch = out.match(/Backup OK:\\s*([^\\s]+)\\s+uploaded/i);\nconst backupFile = fileMatch ? fileMatch[1] : null;\n\nreturn [{\n  exitCode,\n  backupFile,\n  raw_output: out.slice(-3500) // recorta para telegram\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        0
      ],
      "id": "b74d83fc-4605-46d4-ac87-831b41f894fc",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "=✅ SecureNet – Backup diario OK  📦 Archivo: {{$json.backupFile || \"OK (archivo no detectado)\"}} 🕒 Fecha: {{$now.toLocaleString()}}  📍 S3: <YOUR_S3_BUCKET>/daily/",
        "additionalFields": {}
