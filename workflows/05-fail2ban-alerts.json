{
  "name": "Alertas de Seguridad (Fail2Ban)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fail2ban",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
