# Pi-hole v6 (/etc/pihole/pihole.toml) - only the settings changed from defaults
[dns]
  upstreams = ["8.8.8.8", "8.8.4.4"]
  interface = "enp0s3"          # internal lab network
  listeningMode = "LOCAL"       # answer only devices on directly attached networks

