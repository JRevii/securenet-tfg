# WireGuard config of the Ubuntu Desktop test client (v1, as used).
[Interface]
PrivateKey = <CLIENT_PRIVATE_KEY>
Address = 10.0.0.2/24
DNS = 192.168.2.10          # Pi-hole

[Peer]
PublicKey = <SERVER_PUBLIC_KEY>
Endpoint = 192.168.2.10:51820
# v1 limitation: only the tunnel subnet is routed through the VPN.
# 192.168.2.0/24 (services + Pi-hole) was reached outside the tunnel.
# v2 fix: AllowedIPs = 10.0.0.0/24, 192.168.2.0/24
AllowedIPs = 10.0.0.0/24
PersistentKeepalive = 25
