# Copy to /root/securenet/.env (root:root, chmod 600) and fill in real values. Never commit .env.
N8N_ENCRYPTION_KEY=change-me-long-random-string
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# Homepage widgets (only HOMEPAGE_VAR_* reach Homepage; referenced as {{HOMEPAGE_VAR_...}})
# Pi-hole v6 app password (Pi-hole has no read-only role and only one app password).
HOMEPAGE_VAR_PIHOLE_KEY=change-me
# Nextcloud serverinfo token: read-only monitoring endpoint, set with
#   occ config:app:set serverinfo token --value <token>
HOMEPAGE_VAR_NEXTCLOUD_TOKEN=change-me
